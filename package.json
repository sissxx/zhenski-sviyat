{
  "name": "zhenski-sviyat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:types": "npx supabase gen types typescript --project-id yxkwpzihfuekffbpsbts --schema public > src/lib/supabase/database.types.ts",
    "email:auth-templates": "node --experimental-strip-types --no-warnings scripts/build-auth-email-templates.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:start": "npx --yes supabase@2.121.0 start -x imgproxy,mailpit,postgres-meta,supavisor",
    "db:stop": "npx --yes supabase@2.121.0 stop",
    "db:reset": "npx --yes supabase@2.121.0 db reset",
    "db:checks": "psql \"postgresql://postgres:postgres@127.0.0.1:54322/postgres\" -v ON_ERROR_STOP=1 -q -f supabase/checks/database_checks.sql",
    "test:db:build": "node --experimental-strip-types --no-warnings scripts/with-db-test-env.mjs npx next build",
    "test:db": "playwright test -c playwright.db.config.ts"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.9.2",
    "@mui/material": "^9.5.0",
    "@mui/material-nextjs": "^9.5.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "server-only": "^0.0.1",
    "stripe": "^23.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
