# Copy to .env.local and fill in. Never commit real values.
# Values: Supabase dashboard -> Project Settings -> API Keys (and Data API for the URL).

# Project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). Safe in the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...). Server only: bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Optional. The site's public address for links in emails, e.g. https://example.org.
# Leave empty to use the address the request came in on (works for Vercel previews).
NEXT_PUBLIC_SITE_URL=

# Brevo transactional email (docs/emails.md). Without these two, emails are logged as "skipped" and not sent.
# API key: Brevo -> SMTP & API -> API keys. Server only, never NEXT_PUBLIC_.
BREVO_API_KEY=
# A verified Brevo sender, e.g. info@<domain>.
EMAIL_FROM_ADDRESS=
# Optional. Defaults to "Сдружение Женски свят".
EMAIL_FROM_NAME=
# Optional. Where replies go.
EMAIL_REPLY_TO=
